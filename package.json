{
  "name": "devkit-quality",
  "version": "0.1.0",
  "description": "Deterministic repository quality scanner for JavaScript and TypeScript projects",
  "bin": {
    "devkit": "bin/devkit.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karan071/devkit-cli.git"
  },
  "homepage": "https://github.com/Karan071/devkit-cli#readme",
  "bugs": {
    "url": "https://github.com/Karan071/devkit-cli/issues"
  },
  "keywords": [
    "cli",
    "typescript",
    "code-quality",
    "slop-scanner",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "Karan Chourasia",
  "type": "commonjs",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "vitest": "^5.0.3"
  }
}
